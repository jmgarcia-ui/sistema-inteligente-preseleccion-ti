ENTORNO=desarrollo
DATABASE_URL=mssql+pyodbc://@localhost/preseleccion_ti?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
FRONTEND_URL=http://localhost:5173
CLAVE_SECRETA_JWT=reemplazar_con_un_secreto_seguro
ALGORITMO_JWT=HS256
MINUTOS_EXPIRACION_TOKEN=30
# --- Opcionales: sin ellas el sistema funciona, pero sin la parte de Azure ---
# CV en Azure Blob Storage (si falta, se guardan en la carpeta "almacenamiento")
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTENEDOR=cvs
# Lectura del CV (Azure AI Document Intelligence)
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_CLAVE=
# Análisis del CV y redacción del correo (Azure OpenAI)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CLAVE=
AZURE_OPENAI_DESPLIEGUE=gpt-4o-mini
# Envío de correos (Azure Communication Services)
AZURE_COMUNICACION_CONNECTION_STRING=
CORREO_REMITENTE=
# Tope de análisis con IA por día
MAXIMO_ANALISIS_POR_DIA=150
